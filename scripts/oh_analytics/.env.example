# Copy to a protected deployment location and set GARAGE_DOOR_ENV_FILE to that path.
MODBUS_HOST=moxa4510.home.arpa
MODBUS_PORT=502
MODBUS_UNIT_ID=1
# Verify this address against a known door state; Pymodbus uses protocol offsets.
MODBUS_INPUT_REGISTER_ADDRESS=21504
GARAGE_DOOR_CHANNEL=6
POLL_INTERVAL_SECONDS=30

TIMEZONE=America/New_York
DOOR_OPEN_CUTOFF=21:05

MQTT_HOST=debian-openhab
MQTT_PORT=1883
WIND_MQTT_TOPIC=Environment_Monitoring_Outside_Wind_Speed
WIND_THRESHOLD_MPH=7
WIND_STALE_SECONDS=300

OTLP_GRPC_ENDPOINT=meerkat.home.arpa:4317
OTLP_INSECURE=true
ALERT_REPEAT_SECONDS=300

HEALTH_HOST=127.0.0.1
HEALTH_PORT=8088
LOG_LEVEL=INFO